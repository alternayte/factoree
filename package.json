{
  "name": "factoree",
  "version": "0.6.11",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:workflow": "vitest run --config vitest.workflow.config.ts",
    "acceptance:live": "node --experimental-strip-types --import ./tests/live/register-loader.mjs tests/live/acceptance-live.ts",
    "acceptance:live:local": "FACTOREE_LIVE_PROFILE=local npm run acceptance:live",
    "acceptance:live:sprite": "FACTOREE_LIVE_PROFILE=sprite npm run acceptance:live",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run ui:lint && npm run ui:build && npm run gen:check && npm run test:integration && npm run test:workflow",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "openapi": "node dist/bin/openapi.js",
    "ui:lint": "npm --prefix ui run lint",
    "ui:build": "npm --prefix ui run build",
    "gen:check": "bash checks/gen-check.sh"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.14",
    "@better-auth/prisma-adapter": "^1.7.14",
    "@fastify/http-proxy": "11.6.5",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.2",
    "@fly/sprites": "^0.2.0",
    "@linear/sdk": "^91.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@temporalio/activity": "^1.22.0",
    "@temporalio/client": "^1.22.0",
    "@temporalio/common": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0",
    "better-auth": "^1.7.14",
    "e2b": "2.58.0",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "playwright": "1.62.1",
    "prom-client": "^15.1.3",
    "yaml": "2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.22.0",
    "@testcontainers/postgresql": "^11.4.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "eslint": "^9.11.1",
    "prisma": "^7.9.1",
    "testcontainers": "^11.4.1",
    "tsc-alias": "^1.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^4.1.11"
  }
}
