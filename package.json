{
  "name": "factoree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:workflow": "vitest run --config vitest.workflow.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:integration && npm run test:workflow && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@fly/sprites": "^0.2.0",
    "@linear/sdk": "^91.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@temporalio/activity": "^1.22.0",
    "@temporalio/client": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "playwright": "1.62.1",
    "prom-client": "^15.1.3",
    "yaml": "2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.22.0",
    "@testcontainers/postgresql": "^11.4.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "eslint": "^9.11.1",
    "prisma": "^7.9.1",
    "testcontainers": "^11.4.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^4.1.11"
  }
}
