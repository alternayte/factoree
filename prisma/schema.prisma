generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                String              @id @default(uuid())
  linearWorkspaceId String              @unique
  name              String
  createdAt         DateTime            @default(now())
  installations     LinearInstallation[]
  githubInstallations GitHubInstallation[]
  products          Product[]
  productPolicyChanges ProductPolicyChange[]
  runs              Run[]
  webhooks          ProcessedWebhook[]
  warmSnapshots     WarmSnapshot[]
  retiredSnapshots  RetiredWarmSnapshot[]
  buildAheadFailures BuildAheadFailure[]
  linearMembers     LinearMember[]
}

model GitHubInstallation {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // The numeric installation identifier GitHub sends. It is stable across an account rename.
  githubInstallationId String   @unique
  // The account login, for an operator to read. Never resolve on it, because it can change.
  accountLogin         String
  createdAt            DateTime @default(now())

  @@index([tenantId])
}

model LinearInstallation {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linearWorkspaceId   String   @unique
  appUserId           String?
  accessTokenCipher   String
  refreshTokenCipher  String?
  expiresAt           DateTime?
  scopes              String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ContextSourceConfiguration {
  id          String   @id @default(uuid())
  tenantId    String
  // SDD section 5 and section 7. A context source belongs to the Product, alongside secrets,
  // autonomy, risk caps, action policy, and redaction.
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // The identifier the built source reports from `ContextSource.id()`.
  sourceId    String
  kind        String
  enabled     Boolean  @default(true)
  endpoint    String
  // SDD section 30. This column names a ProductSecret. It never holds a credential.
  secretName  String?
  settings    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, sourceId])
  @@index([tenantId])
}

model Run {
  id                       String    @id @default(uuid())
  tenantId                 String
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Task 9. Delegation routes through the Product, not the Project, so this column carries a
  // Product id, with a real foreign key. There is no fallback to a Project default.
  productId                String
  product                  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  linearIssueId            String?
  // docs/specs/run-recovery.md. A follow-up run shares the agent session of the run it follows.
  linearAgentSessionId     String
  followUpOfRunId          String?   @map("follow_up_of_run_id")
  // docs/specs/run-recovery.md. The base64 of the last patch a check sprite captured, so a
  // follow-up run can read what the failed run tried.
  lastPatchBase64          String?   @map("last_patch_base64")
  // docs/specs/draft-of-failed-run.md, DI-21.76. The attempt whose check sprite received the last
  // patch, so a draft names the review of that same patch. Null on a run from before it.
  lastPatchAttempt         Int?      @map("last_patch_attempt")
  temporalWorkflowId       String    @unique
  status                   String
  failureReason            String?
  failureCategory          String?
  // docs/specs/run-visibility.md. The sentence that told the human why the run ended, and the
  // work item title and URL, so a run list names the issue. Null on a run from before them.
  failureMessage           String?   @map("failure_message")
  workItemTitle            String?   @map("work_item_title")
  workItemUrl              String?   @map("work_item_url")
  autonomyLevel            String
  implementerRunner        String?
  validatorRunner          String?
  reviewerRunner           String?
  spriteId                 String?
  spriteAdapter            String?
  spriteRetainUntil        DateTime?
  // docs/specs/sandbox-provider-spillover.md. The sandbox provider the run is pinned to. It stays
  // after the reaper clears spriteAdapter, so the run page and the proof pack can name it.
  sandboxProviderId        String?   @map("sandbox_provider_id")
  baseSha                  String?
  organizationSkillsSha    String?
  // docs/specs/skill-registry.md. The registry set the run used, null for every released skill,
  // and the resolution id that pins each version. Both stay null without a registry.
  skillRegistrySet         String?   @map("skill_registry_set")
  skillResolutionId        String?   @map("skill_resolution_id")
  // docs/specs/external-context-delivery.md. One entry per context file of the work sprite: ref,
  // path, SHA-256, verified and the skip reason. It holds no content (SDD section 55).
  deliveredContext         Json?     @map("delivered_context")
  // Specification section 8. The SHA-256 of .factoree/config.yaml, read from the target
  // repository at the Run's base commit. Null until context resolution pins that commit.
  configSha                 String?
  patchSha256              String?
  commitSha                String?
  pullRequestUrl           String?
  contextContractVersion   String?
  validationContractVersion String?
  proofPackSha256          String?
  proofPackPostedAt        DateTime?
  // docs/specs/proof-pack-and-visual-evidence.md. The proof-pack.json document an agent reads.
  proofPackDocument        Json?
  // docs/specs/own-proposals-and-parallel-runs.md. Every proposal Factoree took without asking.
  decisions                Json      @default("[]")
  repairCount              Int       @default(0)
  createdAt                DateTime  @default(now())
  startedAt                DateTime?
  completedAt              DateTime?
  // DI-21.56. The time the Run waited for a run slot (QUEUED) or a sandbox slot. It is not work,
  // so the shown duration and the deadline leave it out.
  waitedMs                 Int       @default(0) @map("waited_ms")
  // docs/specs/release-0-1-0.md, DI-15.13. The moment the Run took one of its Product's
  // maxConcurrentRuns slots. A Run holds the slot until its status is terminal.
  slotGrantedAt            DateTime?
  // docs/specs/egress-honesty-and-issue-status.md, DI-21.49. The Linear state the run moved its
  // issue from, and the state it set. Both null when the run moved nothing.
  issueStateFromId         String?   @map("issue_state_from_id")
  issueStateSetId          String?   @map("issue_state_set_id")
  // Issue #45, DI-21.65. The first stop that reached the workflow: when, from where ("linear" or
  // "factoree_ui"), and the admin who sent a Factoree UI stop. Null when nobody stopped the run.
  stopRequestedAt          DateTime? @map("stop_requested_at")
  stopSource               String?   @map("stop_source")
  stopRequestedBy          String?   @map("stop_requested_by")
  // docs/specs/draft-of-failed-run.md, DI-21.79. The request that started the draft workflow: when,
  // from where ("linear" or "factoree_ui"), and the Linear user or the admin who asked.
  draftRequestedAt         DateTime? @map("draft_requested_at")
  draftSource              String?   @map("draft_source")
  draftRequestedBy         String?   @map("draft_requested_by")
  // docs/specs/blocked-by-wait.md. Each blocker of a WAITING_FOR_BLOCKERS run as the last read saw
  // it: issue id, identifier, URL, state type and Factoree pull request URL. Null before the first
  // read, and on a run that never waited.
  blockers                 Json?     @map("blockers")
  // docs/specs/blocked-by-wait.md, DI-21.83. The workflow input of a waiting run, built at the
  // delegation, so the sweep starts the run with it. Null on a run that never waited.
  waitingStartInput        Json?     @map("waiting_start_input")
  executions               AgentExecution[]
  agentSessions            AgentSession[]
  stages                   RunStage[]
  skills                   RunSkill[]
  skillProposals           RunSkillProposal[]
  evidence                 Evidence[]
  contextContract          ContextContract?
  validationContract       ValidationContract?
  validationResults        ValidationAssertionResult[]
  reviewFindings           ReviewFinding[]
  targets                  RunTarget[]

  @@index([tenantId])
  @@index([productId, status])
  @@index([spriteRetainUntil])
  @@index([linearAgentSessionId, createdAt])
  // docs/specs/blocked-by-wait.md. The sweep reads every waiting run each minute.
  @@index([status])
}

model AgentExecution {
  id             String    @id @default(uuid())
  tenantId       String
  runId          String
  run            Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  role           String
  runner         String
  model          String?
  sessionRef     String?
  promptVersion  String?
  durationMs     Int?
  finalResult    Json?
  costMetadata   Json?
  // Identifies one execution attempt. The caller sets this, so a Temporal activity retry with
  // unchanged arguments collides on the same key and does not write a second row. A distinct
  // attempt, for example a repair loop attempt, uses a distinct key and writes a distinct row.
  idempotencyKey String
  createdAt      DateTime  @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([runId])
}

// docs/specs/agent-session-usage-and-hangs.md. One row per agent session, with the usage the
// agent CLI recorded. The columns are snake_case, so an operator queries cost per Run, role and
// Product in plain SQL. DI-14.42. A usage field is null when the CLI left no record.
model AgentSession {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  runId            String   @map("run_id")
  run              Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  role             String
  attempt          Int
  runner           String
  cliSessionId     String?  @map("cli_session_id")
  model            String?
  effort           String?
  inputTokens      Int?     @map("input_tokens")
  outputTokens     Int?     @map("output_tokens")
  reasoningTokens  Int?     @map("reasoning_tokens")
  cacheReadTokens  Int?     @map("cache_read_tokens")
  cacheWriteTokens Int?     @map("cache_write_tokens")
  costUsd          Float?   @map("cost_usd")
  turns            Int?
  durationMs       Int      @map("duration_ms")
  longestTurnMs    Int?     @map("longest_turn_ms")
  // docs/specs/run-speed.md. The time the session spent in model calls and in tool calls.
  modelMs          Int?     @map("model_ms")
  toolMs           Int?     @map("tool_ms")
  // finished, hung or failed.
  outcome          String
  // One key per session. A Temporal retry of the activity upserts the same row.
  idempotencyKey   String   @map("idempotency_key")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([runId])
}

// docs/specs/run-speed.md. One row per stage of a run: when it started and when it ended. The
// columns are snake_case, so an operator finds the slow stage in plain SQL.
model RunStage {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  runId     String   @map("run_id")
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage     String
  attempt   Int
  // The sandbox the stage ran in, or null for a stage outside a sandbox.
  sandboxId String?  @map("sandbox_id")
  startedAt DateTime @map("started_at")
  endedAt   DateTime @map("ended_at")

  @@index([runId])
  @@map("run_stage")
}

// docs/specs/skill-registry.md. One row per skill a run received. SDD section 55.
model RunSkill {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  runId     String  @map("run_id")
  run       Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  // repository, registry or organization.
  source    String
  name      String
  path      String
  // The registry version and archive digest. Null for a skill from a checkout.
  version   Int?
  sha256    String?
  // True when the implementer prompt lists the skill.
  listed    Boolean
  activated Boolean @default(false)

  @@unique([runId, path])
  @@map("run_skill")
}

// docs/specs/skill-registry.md. One row per skill proposal of a run.
model RunSkillProposal {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  runId     String   @map("run_id")
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  name      String
  // registry or organization.
  source    String
  // submitted, refused or failed.
  state     String
  reference String?
  url       String?
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([runId, name, source])
  @@map("run_skill_proposal")
}

model Evidence {
  id                    String   @id @default(uuid())
  tenantId              String
  runId                 String
  run                   Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Null for a deterministic check. SDD section 35 records a check that answers no assertion.
  // Otherwise the validation assertion this artifact answers.
  validationAssertionId String?
  validationAssertion   ValidationAssertion? @relation(fields: [validationAssertionId], references: [id], onDelete: SetNull)
  kind                  String
  source                String
  sha256                String
  storageRef            String?
  metadata              Json
  // A Temporal retry of one activity must not write a second row.
  idempotencyKey        String
  createdAt             DateTime @default(now())

  @@unique([runId, idempotencyKey])
  @@index([tenantId, runId])
}

model ContextContract {
  id          String   @id @default(uuid())
  tenantId    String
  runId       String   @unique
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  // SDD section 21 fixes the document schema version. `Run.contextContractVersion` holds the
  // SHA-256 below, because that value identifies the exact contract. See DI-4.11.
  version     Int
  sha256      String
  // The rendered contract. SDD section 55 forbids a copy of a repository. This text names paths
  // and hashes. It holds no file body.
  document    String
  createdAt   DateTime @default(now())
  items       ContextItem[]
  conflicts   ContextConflict[]

  @@index([tenantId])
}

model ContextItem {
  id                String          @id @default(uuid())
  tenantId          String
  contextContractId String
  contextContract   ContextContract @relation(fields: [contextContractId], references: [id], onDelete: Cascade)
  // SDD section 21 requires a source, a stable reference, a source version, an authority class, a
  // reason, and a classification on every selected item. SDD section 55 adds the repository, the
  // commit SHA, the path, and the content hash.
  sourceId          String
  ref               String
  repository        String?
  sha               String?
  path              String?
  sourceVersion     String
  authority         String
  reason            String
  classification    String
  topics            String[]        @default([])
  contentSha256     String?
  createdAt         DateTime        @default(now())

  @@unique([contextContractId, ref])
  @@index([tenantId])
}

model ContextConflict {
  id                String          @id @default(uuid())
  tenantId          String
  contextContractId String
  contextContract   ContextContract @relation(fields: [contextContractId], references: [id], onDelete: Cascade)
  // SDD section 23 fixes this shape. `winnerRef` and `loserRef` are null for an unresolved
  // conflict, because no authority rule gave a winner.
  conflictKey       String
  subject           String
  // SDD section 22 makes authority domain-specific. The domain with the subject names the
  // question a human answered, so the record must carry it.
  authorityDomain   String
  winnerRef         String?
  loserRef          String?
  reason            String
  resolution        String
  createdAt         DateTime        @default(now())

  @@unique([contextContractId, conflictKey])
  @@index([tenantId])
}

model ValidationContract {
  id          String   @id @default(uuid())
  tenantId    String
  runId       String   @unique
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  // SDD section 24 fixes the document schema version. `Run.validationContractVersion` holds the
  // SHA-256 below, because that value identifies the exact frozen contract. See controller
  // decision 5.
  version     Int
  sha256      String
  workItem    String
  goal        String
  // The rendered contract. It reaches the Implementer, the User Validator, and the Proof Pack.
  document    String
  createdAt   DateTime @default(now())
  assertions  ValidationAssertion[]

  @@index([tenantId])
}

model ValidationAssertion {
  id                   String             @id @default(uuid())
  tenantId             String
  validationContractId String
  validationContract   ValidationContract @relation(fields: [validationContractId], references: [id], onDelete: Cascade)
  // SDD section 24 requires a unique identifier, a source requirement, an observable behavior, a
  // method, required evidence, and permitted preconditions on every assertion.
  assertionKey         String
  requirement          String
  statement            String
  method               String
  evidence             String[]
  preconditions        String[]
  evidenceRows         Evidence[]
  results              ValidationAssertionResult[]

  @@unique([validationContractId, assertionKey])
  @@index([tenantId])
}

model ValidationAssertionResult {
  id                    String              @id @default(uuid())
  tenantId              String
  runId                 String
  run                   Run                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  validationAssertionId String
  assertion             ValidationAssertion @relation(fields: [validationAssertionId], references: [id], onDelete: Cascade)
  assertionKey          String
  // PASS, FAIL, BLOCKED, or MANUAL_REQUIRED. SDD section 36.
  result                String
  reason                String
  attempt               Int
  createdAt             DateTime            @default(now())

  @@unique([runId, validationAssertionId, attempt])
  @@index([tenantId, runId])
}

model ReviewFinding {
  id             String   @id @default(uuid())
  tenantId       String
  runId          String
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  // The review pass this finding belongs to. The first pass is 1. SDD section 42.
  attempt        Int
  // The agent claim of SDD section 41. It is recorded and it decides nothing.
  verdict        String
  // The identifier the Reviewer gave the finding, for example RV-1.
  findingKey     String
  // blocker, high, medium, or low. SDD section 41.
  severity       String
  category       String
  requirement    String
  evidence       String
  description    String
  // Factoree's own decision. SDD section 41 and DI-8.2.
  blocking       Boolean
  decisionReason String
  createdAt      DateTime @default(now())

  @@unique([runId, attempt, findingKey])
  @@index([tenantId, runId])
}

model ProcessedWebhook {
  id         String   @id @default(uuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  deliveryId String   @unique
  eventType  String
  receivedAt DateTime @default(now())

  @@index([tenantId])
}

/// docs/specs/kiln-sandbox-provider.md. One warm snapshot per tenant, sandbox provider and repository.
/// docs/specs/sandbox-provider-spillover.md. `adapter` holds the sandbox provider id.
model WarmSnapshot {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adapter       String
  repositoryUrl String
  // docs/specs/kiln-sandbox-size.md. The Kiln template: the image digest and the size.
  template      String
  // docs/specs/run-speed.md. The SHA-256 of the bootstrap command, the warm command and the
  // effective bootstrap allow list: the inputs that decide what the snapshot holds.
  bootstrapKey  String
  // The exit code of a failed warm command, or null when it passed or none ran.
  warmCommandExitCode Int?
  snapshotId    String
  createdAt     DateTime @default(now())

  @@unique([tenantId, adapter, repositoryUrl])
}

// DI-15.29. A warm snapshot that no WarmSnapshot row names any more and that the provider still
// holds: a replaced one that a live sandbox still read, or one that did not restore. The reaper
// removes it, and drops the row once the provider lets the snapshot go.
model RetiredWarmSnapshot {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adapter    String
  snapshotId String
  createdAt  DateTime @default(now())

  @@unique([adapter, snapshotId])
}

// docs/specs/release-0-1-0.md, DI-15.14. One live sandbox of a provider that Factoree created, from
// the reservation before the create until the delete. The maxLive of its provider counts these rows.
// docs/specs/sandbox-provider-spillover.md. `adapter` holds the sandbox provider id. A held lease
// is one of the three slots a run takes at start: unbound while no sandbox of the run uses it.
model SandboxLease {
  id            String    @id @default(uuid())
  adapter       String
  runId         String
  held          Boolean   @default(false)
  // Null between the reservation and the end of the create.
  sandboxId     String?
  createdAt     DateTime  @default(now())
  // Set while a worker deletes this retained sandbox to free its slot.
  evictingSince DateTime?
  // Set when a delete at the provider failed. The sandbox still lives, so the lease stays, and the
  // reaper deletes it again on each pass until the provider confirms it.
  destroyFailedAt DateTime? @map("destroy_failed_at")

  @@unique([adapter, sandboxId])
  @@index([adapter, createdAt])
  @@index([runId])
  @@index([destroyFailedAt])
}

// docs/specs/sandbox-provider-spillover.md. One sandbox provider of the install: a Kiln host, an E2B
// account, a Sprites account or the local adapter. The id is stable: leases, warm snapshots and
// runs name it. The first provider of a type takes the type name as its id.
model SandboxProvider {
  id           String    @id
  name         String
  // kiln, e2b, fly-sprites or local.
  type         String
  // The Kiln host, the Sprites API base URL, or a self-hosted E2B URL. Null means the type default.
  url          String?
  apiKeyCipher String?
  // The limit of live sandboxes on this provider. Null means no limit.
  maxLive      Int?
  vcpus        Int?
  memoryMb     Int?
  // A lower number is a better priority.
  priority     Int       @default(1)
  enabled      Boolean   @default(true)
  // Set when a work sprite create failed. Selection skips the provider until then.
  downUntil    DateTime?
  downReason   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// docs/specs/sandbox-provider-spillover.md. The last failed build-ahead of one repository on one
// sandbox provider. Selection skips the provider for the repository while the row exists, and a
// build-ahead that succeeds there deletes it.
model BuildAheadFailure {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerId    String
  repositoryUrl String
  reason        String
  failedAt      DateTime @default(now())

  @@unique([tenantId, providerId, repositoryUrl])
}

model Product {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  // "pending" until an operator supplies secrets and activates it. A pending Product runs at L0.
  status         String   @default("pending")
  linearTeamKey  String
  linearTeamId   String
  defaultAutonomy String  @default("L0")
  // docs/specs/autonomy-levels.md. The highest level each Linear label allows, by label. Null
  // means the SDD section 28 list, each label capped at L2.
  riskCaps       Json?
  // R-4. The egress ceiling of every sandbox of this Product. A repository can only narrow it.
  allowedDomains String[] @default([])
  maxRunMinutes  Int      @default(90)
  // docs/specs/claude-code-runner.md. The runner of every role that names none: opencode or claude.
  defaultRunner  String   @default("opencode") @map("default_runner")
  // The default model, in the form of the default runner. Null means the CLI default model.
  model          String?
  // The runner and the model of each role. Null means the default runner and the default model.
  runnerImplementer String? @map("runner_implementer")
  runnerRefiner     String? @map("runner_refiner")
  runnerValidator   String? @map("runner_validator")
  runnerReviewer    String? @map("runner_reviewer")
  runnerSetup       String? @map("runner_setup")
  modelImplementer  String? @map("model_implementer")
  modelRefiner      String? @map("model_refiner")
  modelValidator    String? @map("model_validator")
  modelReviewer     String? @map("model_reviewer")
  modelSetup        String? @map("model_setup")
  // The reasoning effort of each role. Null means the CLI default for that role.
  effortImplementer String?
  effortRefiner     String?
  effortValidator   String?
  effortReviewer    String?
  // docs/specs/repository-setup-and-services.md. Null means the implementer's effort.
  effortSetup       String?  @map("effort_setup")
  // The silence limit: an agent session that writes no output for this many minutes is hung.
  silenceMinutes Int      @default(10)
  // Issue #39, DI-21.66. The most criteria a refiner proposal may hold, 1 to 50.
  refinerCriteriaLimit Int @default(20) @map("refiner_criteria_limit")
  // Issue #43, DI-21.67. The repair budget of a run, 0 to 10. A repository's
  // `repair.maxAttempts` in .factoree/config.yaml replaces it.
  repairMaxAttempts Int @default(2) @map("repair_max_attempts")
  // SDD section 51. The hours a finished sandbox stays for inspection before the reaper deletes it.
  sandboxRetentionHours Int @default(24)
  // docs/specs/sandbox-provider-spillover.md. The sandbox provider ids the runs of this product may
  // use. Empty allows every provider.
  sandboxProviderIds String[] @default([]) @map("sandbox_provider_ids")
  // docs/specs/setup-app-change-issues.md. one_per_change or one_for_all: how many app-change
  // issues a merged setup creates.
  appChangeIssues String @default("one_per_change") @map("app_change_issues")
  // The most Runs of this Product that run at one time. The gate before PREPARING enforces it (DI-15.13).
  maxConcurrentRuns Int   @default(2)
  // SDD section 16. A Product can define one organization-wide skills repository. The value is
  // an owner and repository slug, the same shape a Repository's `fullName` uses.
  organizationSkillsRepository String?
  // docs/specs/skill-registry.md. The skill registry of this Product: its kind, its base URL and
  // its set. A null set means every released skill. The service key is the Product secret
  // SKILL_REGISTRY_KEY, never a column.
  skillRegistryKind String? @map("skill_registry_kind")
  skillRegistryUrl  String? @map("skill_registry_url")
  skillRegistrySet  String? @map("skill_registry_set")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  repositories   Repository[]
  setups         RepositorySetup[]
  appChangeIssueRows SetupAppChangeIssue[]
  secrets        ProductSecret[]
  contextSources ContextSourceConfiguration[]
  runs           Run[]
  policyChanges  ProductPolicyChange[]

  @@unique([tenantId, slug])
  // One Linear team maps to at most one Product. This constraint makes the routing rule of
  // specification section 9 satisfiable at the database level.
  @@unique([tenantId, linearTeamId])
  @@index([tenantId])
}

model Repository {
  id                   String   @id @default(uuid())
  tenantId             String
  productId            String
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fullName             String
  defaultBranch        String   @default("main")
  // The commit of `.factoree/config.yaml` that discovery last read.
  configSha            String
  // Names only. A value never reaches this column.
  linearProjects       String[] @default([])
  requestedSecretNames String[] @default([])
  discoveredAt         DateTime @default(now())
  lastSeenAt           DateTime @default(now())
  // Set when the configuration file disappears. The row stays, so the Run history survives.
  absentSince          DateTime?
  // The installation that granted access to this repository. Discovery knows it at sync time.
  // A clone or a push mints its token against this installation.
  githubInstallationId String
  // docs/specs/repository-setup-and-services.md. Set when a build-ahead fails, so the product page
  // offers "Run setup again". A build-ahead that succeeds clears it.
  needsSetupReason     String?   @map("needs_setup_reason")
  needsSetupAt         DateTime? @map("needs_setup_at")
  runTargets           RunTarget[]

  @@unique([tenantId, fullName])
  @@index([productId])
}

model ProductSecret {
  id          String   @id @default(uuid())
  tenantId    String
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  valueCipher String
  injectIntoImplementer Boolean @default(false)
  kind        String   @default("test")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, name])
  @@index([tenantId])
}

model RunTarget {
  id              String     @id @default(uuid())
  tenantId        String
  runId           String
  run             Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  repositoryId    String
  repository      Repository @relation(fields: [repositoryId], references: [id])
  selectionReason String
  baseSha         String?
  patchSha256     String?
  commitSha       String?
  pullRequestUrl  String?
  // docs/specs/proof-pack-and-visual-evidence.md. The pull request preview that CI published for
  // the commit, from a GitHub deployment status. A link for humans, never evidence.
  previewUrl      String?
  // docs/specs/egress-honesty-and-issue-status.md, DI-21.51. The pull request number, and open,
  // merged or closed from the GitHub pull_request event.
  pullRequestNumber Int?     @map("pull_request_number")
  pullRequestState  String?  @map("pull_request_state")
  createdAt       DateTime   @default(now())

  @@unique([runId, repositoryId])
  @@index([runId])
  @@index([tenantId])
  @@index([tenantId, commitSha])
  @@index([tenantId, pullRequestNumber])
}

// docs/specs/autonomy-levels.md. One row for each change of a Product policy field, so raising
// trust leaves an audit trail.
model ProductPolicyChange {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  field     String
  oldValue  Json?
  newValue  Json?
  changedAt DateTime @default(now())

  @@index([productId])
  @@index([tenantId])
}

// docs/specs/release-0-1-0.md. The install settings. One row, with the id "install". Every
// credential column holds AES-256-GCM cipher text under FACTOREE_MASTER_KEY. No value has an
// environment fallback.
model InstallSettings {
  id                          String    @id @default("install")
  githubAppId                 String?
  githubAppSlug               String?
  githubAppClientId           String?
  githubAppClientSecretCipher String?
  githubAppPrivateKeyCipher   String?
  githubWebhookSecretCipher   String?
  githubBaseUrl               String    @default("https://github.com")
  githubApiBaseUrl            String    @default("https://api.github.com")
  linearClientId              String?
  linearClientSecretCipher    String?
  linearWebhookSecretCipher   String?
  // A sandbox image by digest. Null means the image the release pins. Every sandbox provider
  // builds its template from it (docs/specs/sandbox-provider-spillover.md).
  sandboxImage                String?
  sandboxRegistryUsername     String?
  sandboxRegistryTokenCipher  String?
  gitAuthorName               String    @default("Factoree")
  gitAuthorEmail              String    @default("factoree@users.noreply.github.com")
  // The SHA-256 of the one-time setup token. The token itself is never stored.
  setupTokenHash              String?
  // The tenant whose Linear workspace admins administer the install settings.
  operatorTenantId            String?
  setupCompletedAt            DateTime?
  updatedAt                   DateTime  @updatedAt
}

// One Linear account of a signed-in user, as Linear reported it at the last sign-in. Factoree
// writes this row, and better-auth never reads it.
model LinearMember {
  id           String   @id @default(uuid())
  // The Linear user id. better-auth stores the same value as Account.accountId.
  linearUserId String   @unique
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin        Boolean
  checkedAt    DateTime @default(now())

  @@index([tenantId])
}

// Every call of the administration API, with the user or the API key that made it.
model AdminAuditEntry {
  id         String   @id @default(uuid())
  userId     String?
  apiKeyId   String?
  method     String
  path       String
  statusCode Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// better-auth. The models and fields follow better-auth 1.7 and its api-key plugin.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@map("auth_user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
  @@map("auth_verification")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("auth_apikey")
}

// docs/specs/repository-setup-and-services.md. One setup run: the setup agent writes the
// configuration of one repository, Factoree proves each part, and opens a pull request.
model RepositorySetup {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  productId            String    @map("product_id")
  product              Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  repositoryFullName   String    @map("repository_full_name")
  githubInstallationId String    @map("github_installation_id")
  workflowId           String    @map("workflow_id")
  // queued, running, proposed, partial, failed, merged, unchanged.
  status               String
  pullRequestUrl       String?   @map("pull_request_url")
  // The setup report: each part proven or failed, and the hosts the sandbox reached.
  report               Json?
  failureMessage       String?   @map("failure_message")
  // The usage of the setup agent session: runner, model, effort, outcome, tokens, cost, time.
  sessionUsage         Json?     @map("session_usage")
  // docs/specs/setup-app-change-issues.md. The setup Factoree started when every app-change issue
  // of this setup ended. Null until then, so a round starts one follow-up setup.
  followUpSetupId      String?   @map("follow_up_setup_id")
  // docs/specs/setup-speed-and-history.md. The setup input key, the setup a skipped setup copied,
  // the Temporal run id (every setup of a repository shares one workflow id), the proof time, and
  // whether the session sandbox started from the warm snapshot.
  inputKey             String?   @map("input_key")
  skippedFromSetupId   String?   @map("skipped_from_setup_id")
  temporalRunId        String?   @map("temporal_run_id")
  proofMs              Int?      @map("proof_ms")
  warm                 Boolean?
  createdAt            DateTime  @default(now()) @map("created_at")
  endedAt              DateTime? @map("ended_at")
  appChangeIssues      SetupAppChangeIssue[]

  @@index([productId, repositoryFullName, createdAt])
  @@map("repository_setup")
}

/// docs/specs/setup-app-change-issues.md. One Linear issue a merged setup created for its app changes.
model SetupAppChangeIssue {
  id                    String          @id @default(uuid())
  tenantId              String          @map("tenant_id")
  productId             String          @map("product_id")
  product               Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  setupId               String          @map("setup_id")
  setup                 RepositorySetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  repositoryFullName    String          @map("repository_full_name")
  // One change, or every change of the setup when the product creates one issue for all.
  changes               String[]
  linearIssueId         String          @map("linear_issue_id")
  linearIssueIdentifier String          @map("linear_issue_identifier")
  // docs/specs/setup-speed-and-history.md. The issue link the setup history shows. Null before it existed.
  linearIssueUrl        String?         @map("linear_issue_url")
  // Null while the issue is open. merged, or not_merged when its run ended without a merged pull request.
  outcome               String?
  createdAt             DateTime        @default(now()) @map("created_at")
  endedAt               DateTime?       @map("ended_at")

  @@index([tenantId, repositoryFullName])
  @@map("setup_app_change_issue")
}

// docs/specs/model-picker.md. The last good copy of the models.dev catalog. One row, keyed by its
// source URL. `data` holds the raw api.json, because the sandbox model file needs the raw entry.
model ModelCatalog {
  source    String   @id
  etag      String?
  data      Json
  fetchedAt DateTime @map("fetched_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("model_catalog")
}
