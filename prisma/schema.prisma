generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                String              @id @default(uuid())
  linearWorkspaceId String              @unique
  name              String
  createdAt         DateTime            @default(now())
  installations     LinearInstallation[]
  projects          Project[]
  runs              Run[]
  webhooks          ProcessedWebhook[]
}

model LinearInstallation {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linearWorkspaceId   String   @unique
  appUserId           String?
  accessTokenCipher   String
  refreshTokenCipher  String?
  expiresAt           DateTime?
  scopes              String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Project {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key                String
  name               String
  primaryRepository  String
  referenceRepositories String[]     @default([])
  // SDD section 16. A Project can define one organization-wide skills repository. The value is
  // an owner and repository slug, the same shape `primaryRepository` uses.
  organizationSkillsRepository String?
  linearTeamId       String?
  defaultAutonomy    String          @default("L2")
  maxRunMinutes      Int             @default(90)
  defaultBranch      String          @default("main")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  secrets            ProjectSecret[]
  runs               Run[]
  contextSources     ContextSourceConfiguration[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model ProjectSecret {
  id          String   @id @default(uuid())
  tenantId    String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  valueCipher String
  // SDD section 30. Only a secret an operator marks reaches the Implementer environment. Every
  // secret reaches the redactor, marked or not.
  injectIntoImplementer Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, name])
  @@index([tenantId])
}

model ContextSourceConfiguration {
  id          String   @id @default(uuid())
  tenantId    String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // The identifier the built source reports from `ContextSource.id()`.
  sourceId    String
  kind        String
  enabled     Boolean  @default(true)
  endpoint    String
  // SDD section 30. This column names a ProjectSecret. It never holds a credential.
  secretName  String?
  settings    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, sourceId])
  @@index([tenantId])
}

model Run {
  id                       String    @id @default(uuid())
  tenantId                 String
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId                String
  project                  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linearIssueId            String?
  linearAgentSessionId     String    @unique
  temporalWorkflowId       String    @unique
  status                   String
  failureReason            String?
  autonomyLevel            String
  implementerRunner        String?
  validatorRunner          String?
  reviewerRunner           String?
  spriteId                 String?
  spriteAdapter            String?
  spriteRetainUntil        DateTime?
  baseSha                  String?
  patchSha256              String?
  commitSha                String?
  pullRequestUrl           String?
  contextContractVersion   String?
  validationContractVersion String?
  proofPackSha256          String?
  proofPackPostedAt        DateTime?
  repairCount              Int       @default(0)
  createdAt                DateTime  @default(now())
  startedAt                DateTime?
  completedAt              DateTime?
  executions               AgentExecution[]
  evidence                 Evidence[]
  contextContract          ContextContract?
  validationContract       ValidationContract?
  validationResults        ValidationAssertionResult[]
  reviewFindings           ReviewFinding[]

  @@index([tenantId])
  @@index([projectId])
  @@index([spriteRetainUntil])
}

model AgentExecution {
  id             String    @id @default(uuid())
  tenantId       String
  runId          String
  run            Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  role           String
  runner         String
  model          String?
  sessionRef     String?
  promptVersion  String?
  durationMs     Int?
  finalResult    Json?
  costMetadata   Json?
  // Identifies one execution attempt. The caller sets this, so a Temporal activity retry with
  // unchanged arguments collides on the same key and does not write a second row. A distinct
  // attempt, for example a repair loop attempt, uses a distinct key and writes a distinct row.
  idempotencyKey String
  createdAt      DateTime  @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([runId])
}

model Evidence {
  id                    String   @id @default(uuid())
  tenantId              String
  runId                 String
  run                   Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Null for a deterministic check. SDD section 35 records a check that answers no assertion.
  // Otherwise the validation assertion this artifact answers.
  validationAssertionId String?
  validationAssertion   ValidationAssertion? @relation(fields: [validationAssertionId], references: [id], onDelete: SetNull)
  kind                  String
  source                String
  sha256                String
  storageRef            String?
  metadata              Json
  // A Temporal retry of one activity must not write a second row.
  idempotencyKey        String
  createdAt             DateTime @default(now())

  @@unique([runId, idempotencyKey])
  @@index([tenantId, runId])
}

model ContextContract {
  id          String   @id @default(uuid())
  tenantId    String
  runId       String   @unique
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  // SDD section 21 fixes the document schema version. `Run.contextContractVersion` holds the
  // SHA-256 below, because that value identifies the exact contract. See controller decision 11.
  version     Int
  sha256      String
  // The rendered contract. SDD section 55 forbids a copy of a repository. This text names paths
  // and hashes. It holds no file body.
  document    String
  createdAt   DateTime @default(now())
  items       ContextItem[]
  conflicts   ContextConflict[]

  @@index([tenantId])
}

model ContextItem {
  id                String          @id @default(uuid())
  tenantId          String
  contextContractId String
  contextContract   ContextContract @relation(fields: [contextContractId], references: [id], onDelete: Cascade)
  // SDD section 21 requires a source, a stable reference, a source version, an authority class, a
  // reason, and a classification on every selected item. SDD section 55 adds the repository, the
  // commit SHA, the path, and the content hash.
  sourceId          String
  ref               String
  repository        String?
  sha               String?
  path              String?
  sourceVersion     String
  authority         String
  reason            String
  classification    String
  topics            String[]        @default([])
  contentSha256     String?
  createdAt         DateTime        @default(now())

  @@unique([contextContractId, ref])
  @@index([tenantId])
}

model ContextConflict {
  id                String          @id @default(uuid())
  tenantId          String
  contextContractId String
  contextContract   ContextContract @relation(fields: [contextContractId], references: [id], onDelete: Cascade)
  // SDD section 23 fixes this shape. `winnerRef` and `loserRef` are null for an unresolved
  // conflict, because no authority rule gave a winner.
  conflictKey       String
  subject           String
  // SDD section 22 makes authority domain-specific. The domain with the subject names the
  // question a human answered, so the record must carry it.
  authorityDomain   String
  winnerRef         String?
  loserRef          String?
  reason            String
  resolution        String
  createdAt         DateTime        @default(now())

  @@unique([contextContractId, conflictKey])
  @@index([tenantId])
}

model ValidationContract {
  id          String   @id @default(uuid())
  tenantId    String
  runId       String   @unique
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  // SDD section 24 fixes the document schema version. `Run.validationContractVersion` holds the
  // SHA-256 below, because that value identifies the exact frozen contract. See controller
  // decision 5.
  version     Int
  sha256      String
  workItem    String
  goal        String
  // The rendered contract. It reaches the Implementer, the User Validator, and the Proof Pack.
  document    String
  createdAt   DateTime @default(now())
  assertions  ValidationAssertion[]

  @@index([tenantId])
}

model ValidationAssertion {
  id                   String             @id @default(uuid())
  tenantId             String
  validationContractId String
  validationContract   ValidationContract @relation(fields: [validationContractId], references: [id], onDelete: Cascade)
  // SDD section 24 requires a unique identifier, a source requirement, an observable behavior, a
  // method, required evidence, and permitted preconditions on every assertion.
  assertionKey         String
  requirement          String
  statement            String
  method               String
  evidence             String[]
  preconditions        String[]
  evidenceRows         Evidence[]
  results              ValidationAssertionResult[]

  @@unique([validationContractId, assertionKey])
  @@index([tenantId])
}

model ValidationAssertionResult {
  id                    String              @id @default(uuid())
  tenantId              String
  runId                 String
  run                   Run                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  validationAssertionId String
  assertion             ValidationAssertion @relation(fields: [validationAssertionId], references: [id], onDelete: Cascade)
  assertionKey          String
  // PASS, FAIL, BLOCKED, or MANUAL_REQUIRED. SDD section 36.
  result                String
  reason                String
  attempt               Int
  createdAt             DateTime            @default(now())

  @@unique([runId, validationAssertionId, attempt])
  @@index([tenantId, runId])
}

model ReviewFinding {
  id             String   @id @default(uuid())
  tenantId       String
  runId          String
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  // The review pass this finding belongs to. The first pass is 1. SDD section 42.
  attempt        Int
  // The agent claim of SDD section 41. It is recorded and it decides nothing.
  verdict        String
  // The identifier the Reviewer gave the finding, for example RV-1.
  findingKey     String
  // blocker, high, medium, or low. SDD section 41.
  severity       String
  category       String
  requirement    String
  evidence       String
  description    String
  // Factoree's own decision. SDD section 41 and controller decision 2.
  blocking       Boolean
  decisionReason String
  createdAt      DateTime @default(now())

  @@unique([runId, attempt, findingKey])
  @@index([tenantId, runId])
}

model ProcessedWebhook {
  id         String   @id @default(uuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  deliveryId String   @unique
  eventType  String
  receivedAt DateTime @default(now())

  @@index([tenantId])
}
