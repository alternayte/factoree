# Sprite live acceptance, SDD section 66 read against docs/live-acceptance.md.
# `npm run acceptance:live:sprite` needs every value below. It substitutes local infrastructure
# for the Temporal service, the Backstage catalog, and the MCP source, and it uses a real Fly
# Sprite. A pass here proves the Sprite integration and the scenario code. It is NOT SDD
# section 66 proof.
#
# The database URL below matches docker-compose.yml. Leave it as it is unless you change the
# PostgreSQL port or credentials.
DATABASE_URL=postgresql://factoree:factoree@localhost:5432/factoree

# The worker must create a real Fly Sprite. Set the sandbox adapter to fly-sprites and supply a
# Sprites token. src/config/env.ts defaults SANDBOX_ADAPTER to fly-sprites, so state it here to
# be explicit and to overwrite a value left over from a local run.
SANDBOX_ADAPTER=fly-sprites
SPRITES_TOKEN=

# The Linear, GitHub, and runner values stay blank. The operator supplies them.
LIVE_LINEAR_API_KEY=
LIVE_LINEAR_TEAM_ID=
LIVE_GITHUB_TOKEN=
LIVE_GITHUB_REPOSITORY=owner/factoree-live-fixture
LIVE_RUNNER_NAME=opencode
LIVE_RUNNER_API_KEY=

# The real Fly Sprite credentials. The scenario needs both to create and delete a Sprite.
LIVE_FLY_API_TOKEN=
LIVE_FLY_ORGANIZATION=

# The values below point at the `just up`, `just temporal`, and `just stubs` local services.
LIVE_LOCAL_TEMPORAL_ADDRESS=localhost:7233
LIVE_LOCAL_TEMPORAL_NAMESPACE=default
LIVE_LOCAL_BACKSTAGE_BASE_URL=http://localhost:4100
LIVE_LOCAL_MCP_ENDPOINT=http://localhost:4200/
